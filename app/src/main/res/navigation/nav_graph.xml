<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.tenantmanagement.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_dashboardFragment_to_addTenantFragment"
            app:destination="@id/addTenantFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />

        <action
            android:id="@+id/action_dashboardFragment_to_viewTenantsFragment"
            app:destination="@id/viewTenantsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />

        <action
            android:id="@+id/action_dashboardFragment_to_paymentListFragment"
            app:destination="@id/paymentListFragment" />
    </fragment>

    <fragment
        android:id="@+id/addTenantFragment"
        android:name="com.example.tenantmanagement.ui.tenants.AddTenantFragment"
        android:label="Add Tenant"
        tools:layout="@layout/fragment_add_tenant">

        <action
            android:id="@+id/action_addTenantFragment_to_viewTenantsFragment"
            app:destination="@id/viewTenantsFragment"
            app:popUpTo="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/viewTenantsFragment"
        android:name="com.example.tenantmanagement.ui.tenants.ViewTenantsFragment"
        android:label="View Tenants"
        tools:layout="@layout/fragment_view_tenants">

        <argument
            android:name="newTenant"
            app:argType="com.example.tenantmanagement.data.model.Tenant"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/paymentListFragment"
        android:name="com.example.tenantmanagement.ui.payments.PaymentListFragment"
        android:label="Rent Payments"
        tools:layout="@layout/fragment_payment_list">
        <action
            android:id="@+id/action_paymentListFragment_to_addPaymentFragment"
            app:destination="@id/addPaymentFragment" />
    </fragment>

    <fragment
        android:id="@+id/addPaymentFragment"
        android:name="com.example.tenantmanagement.ui.payments.AddPaymentFragment"
        android:label="Payment"
        tools:layout="@layout/fragment_add_payment">
        <argument
            android:name="payment"
            app:argType="com.example.tenantmanagement.data.model.Payment"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

</navigation>
